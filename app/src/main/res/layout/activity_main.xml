<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="12dp">

    <!-- شريط التحكم العلوي (Bar) المخفي لحين تسجيل الدخول -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="10dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"> <!-- بيبان أول ما تسجل دخول وتدخل بروفايلك -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧹 لوحة تحكم Hema Repost Cleaner"
            android:textColor="#fe2c55"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الجهوزية: جاهز لبدء الدفعة"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnBatchDelete"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:backgroundTint="#fe2c55"
            android:text="🗑️ ابدأ حذف دفعة (50 فيديو)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- متصفح تيك توك -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
